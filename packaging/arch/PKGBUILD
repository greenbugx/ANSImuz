# Maintainer: greenbugx <jesuschetia.gg@gmail.com>
pkgname=ansimuz-git
_name=ANSImuz
pkgver=0.1.3.r0.ga5a9b2b
pkgrel=1
pkgdesc="A lightweight fast TUI to stream your favourite music with pure 8-bit ANSI vibes"
arch=('x86_64')
url="https://github.com/greenbugx/ANSImuz"
license=('MIT')

depends=(
    'gcc-libs'
    'glibc'
    'mpv'
    'python>=3.11'
    'python-ytmusicapi'
    'python-spotifyscraper' #AUR
    'python-pillow'
    'python-requests'
)

makedepends=('git' 'cargo' 'cmake' 'mpv' 'curl')

provides=('ansimuz')
conflicts=('ansimuz')

options=('!lto' '!debug')

if [[ -n "${ANSIMUZ_RELEASE_TAG:-}" ]]; then
    source=("$_name::git+$url.git#tag=$ANSIMUZ_RELEASE_TAG")
else
    source=("$_name::git+$url.git")
fi

sha256sums=('SKIP')

pkgver() {
    cd "$srcdir/$_name"
    git describe --long --tags 2>/dev/null | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g' \
      || printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
    cd "$srcdir/$_name"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"

    bash ./scripts/setup_qjs_linux.sh

    local ytdlp_whl="yt_dlp-2026.11.23-py3-none-any.whl"
    local ytdlp_url="https://files.pythonhosted.org/packages/30/1e/f4bf64ca733135e609696c6df77a6c22c6d4909b6e293e4563ae51ea335c/${ytdlp_whl}"
    local ytdlp_sha="e9188e0c559905f7ee05acc1ba0b6fb3f310e7565bf6dea5f62b5300e0775e35"

    local ejs_whl="yt_dlp_ejs-0.8.0-py3-none-any.whl"
    local ejs_url="https://files.pythonhosted.org/packages/e3/bd/520769863744b669440a924271a6159ddd82ad5ae26b4ac4d4b69e9f8d44/${ejs_whl}"
    local ejs_sha="79300e5fca7f937a1eeede11f0456862c1b41107ce1d726871e0207424f4bdb4"

    mkdir -p "$srcdir/vendor-wheels" "$srcdir/$_name/vendor"
    curl -fsSL "$ytdlp_url" -o "$srcdir/vendor-wheels/$ytdlp_whl"
    curl -fsSL "$ejs_url" -o "$srcdir/vendor-wheels/$ejs_whl"
    echo "$ytdlp_sha  $srcdir/vendor-wheels/$ytdlp_whl" | sha256sum -c --status
    echo "$ejs_sha  $srcdir/vendor-wheels/$ejs_whl" | sha256sum -c --status

    python3 -m zipfile -e "$srcdir/vendor-wheels/$ytdlp_whl" "$srcdir/$_name/vendor"
    python3 -m zipfile -e "$srcdir/vendor-wheels/$ejs_whl" "$srcdir/$_name/vendor"
}

build() {
    cd "$srcdir/$_name"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    export PYO3_PYTHON=/usr/bin/python
    export ANSIMUZ_DATA_DIR=/usr/share/ansimuz
    unset VIRTUAL_ENV

    # strip $srcdir from embedded paths (Rust and C code)
    export RUSTFLAGS="$RUSTFLAGS --remap-path-prefix=$srcdir=/build"
    export CFLAGS="$CFLAGS -ffile-prefix-map=$srcdir=/build"
    export CXXFLAGS="$CXXFLAGS -ffile-prefix-map=$srcdir=/build"

    cargo build --frozen --release
}

package() {
    cd "$srcdir/$_name"
    install -Dm755 target/release/ansimuz "$pkgdir/usr/bin/ansimuz"
    install -d "$pkgdir/usr/share/ansimuz"
    cp -a backend assets runtime vendor "$pkgdir/usr/share/ansimuz/"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 THIRD-PARTY-LICENSES.md "$pkgdir/usr/share/licenses/$pkgname/THIRD-PARTY-LICENSES.md"
    install -Dm644 README.md "$pkgdir/usr/share/doc/ansimuz/README.md"
}
